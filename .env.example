# Required: password for /admin. No password = nobody gets in.
TRADE_SHARK_PASSWORD=

# Supabase Postgres (project settings -> Database -> Connection string). Tables live in the trade_shark schema.
# Transaction pooler, used by the app:
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=trade_shark"
# Session pooler, used only by `prisma db push`:
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=trade_shark"

# Supabase Storage for scans (private bucket). Leave both unset to store scans on local disk in DATA_DIR.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=trade-shark-scans
DATA_DIR=./data

# Public URL of the shop, used for eBay PicURL and links in exports. Optional.
SITE_URL=

# Shop contact (public /contact page and mailto links)
SHOP_EMAIL=
SHOP_OWNER_NAME=

# Optional: higher rate limits for the Pokemon TCG API
POKEMONTCG_API_KEY=

# Optional: vision identification (either one works; Anthropic is tried first)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VISION_CONCURRENCY=2
# Per-call vision timeout. Keep it under your Netlify function timeout.
VISION_TIMEOUT_MS=22000

# Optional: eBay comps (client-credentials app keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# Optional: a sports catalog key. The adapter is a stub until you wire a provider.
SPORTS_CATALOG_API_KEY=
